{
  "name": "devhub-app",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "node --experimental-strip-types --import ./tests/helpers/register.mjs --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-rust.ps1",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.js",
    "lint:check": "node scripts/check-lint.mjs",
    "license:report": "node scripts/license-report.mjs",
    "sbom": "node scripts/sbom.mjs --check --out .pack/bom.json",
    "audit:report": "node scripts/audit-report.mjs",
    "mcp": "node scripts/mcp-devhub.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "rust:supply": "node scripts/rust-supply.mjs",
    "check": "node scripts/check-invariants.mjs && node scripts/check-events.mjs && node scripts/check-registry.mjs && node scripts/check-docs.mjs && node scripts/check-compose.mjs && node scripts/check-build-env.mjs && node scripts/check-lint.mjs && node --experimental-strip-types --import ./tests/helpers/register.mjs scripts/contrast-audit.mjs",
    "gate": "pnpm exec tsc --noEmit && pnpm exec tsc -p tsconfig.tests.json --noEmit && pnpm exec tsc -p tsconfig.node.json && pnpm test && pnpm check",
    "verify": "pnpm gate && pnpm build && node scripts/check-dist.mjs && node scripts/license-report.mjs --check && node scripts/rust-supply.mjs && node scripts/sbom.mjs --check --out .pack/bom.json",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\tauri.ps1",
    "atlas": "node scripts/bundle-atlas.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "contrast:audit": "node --experimental-strip-types --import ./tests/helpers/register.mjs scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "0.10.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
