{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub",
  "identifier": "com.devhub.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevHub",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0c0d10",
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-features=CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' https://api.github.com https://github.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/cache/covers/*.png",
          "**/cache/covers/*.jpg",
          "**/cache/covers/*.webp",
          "**/cache/covers/*.gif"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
